# Banco de dados PostgreSQL
DATABASE_URL="postgresql://propostas:propostas@localhost:5432/propostas?schema=public"

# Chave para assinar o login. Gere com: openssl rand -base64 48
SESSION_SECRET="troque-por-uma-chave-aleatoria-com-mais-de-32-caracteres"

# Desenvolvimento: força os links públicos a usarem este endereço.
# Em produção, deixe vazio para usar o domínio de cada empresa (propostas.caddi.com.br etc.).
PUBLIC_BASE_URL="http://localhost:3000"

# Em produção os links públicos só abrem no domínio da empresa dona da proposta.
# Em desenvolvimento, "true" permite abrir em localhost.
ALLOW_ANY_HOST="true"

# Usuário inicial criado pelo seed (troque a senha no primeiro acesso)
SEED_ADMIN_EMAIL="admin@propostas.local"
SEED_ADMIN_PASSWORD="trocar-esta-senha"

# E-mail de avisos (opcional). Sem SMTP_HOST, os avisos vão só para o log.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Propostas <propostas@caddi.com.br>"
ADMIN_BASE_URL="http://localhost:3000"
