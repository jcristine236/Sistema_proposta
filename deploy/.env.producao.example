# Copie para ".env" na raiz do projeto e preencha. Nunca versione o .env real.

# Senha do PostgreSQL (gere uma forte: openssl rand -base64 24)
DB_PASSWORD=

# Chave do login (openssl rand -base64 48)
SESSION_SECRET=

# Domínio do painel interno (precisa de registro DNS próprio)
PAINEL_DOMINIO=painel.caddi.com.br
ADMIN_BASE_URL=https://painel.caddi.com.br

# E-mail para o Let's Encrypt avisar sobre certificados
ACME_EMAIL=ti@caddi.com.br

# Produção: links usam o domínio de cada empresa e só abrem nele
PUBLIC_BASE_URL=
ALLOW_ANY_HOST=false

# Primeiro acesso (troque a senha depois)
SEED_ADMIN_EMAIL=admin@caddi.com.br
SEED_ADMIN_PASSWORD=
# (12+ caracteres, letras e números; o seed recusa senha fraca)

# Avisos por e-mail (opcional, mas recomendado)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Propostas <propostas@caddi.com.br>

# Aviso de aceite por WhatsApp (opcional): evolution | meta | webhook
WHATSAPP_PROVIDER=
# Evolution API (auto-hospedada)
EVOLUTION_URL=
EVOLUTION_INSTANCE=
EVOLUTION_APIKEY=
# WhatsApp Cloud API (Meta) — exige modelo de mensagem aprovado com 1 variável
META_TOKEN=
META_PHONE_ID=
META_TEMPLATE=
# Webhook (n8n, Make, Zapier...) — recebe {para, texto, evento, proposta}
WHATSAPP_WEBHOOK_URL=
WHATSAPP_WEBHOOK_SECRET=
