# Copie para web/.env e preencha. Os valores abaixo são para teste local.
# Produção: veja deploy/README.md (DEBUG=false, MODO_HTTP=false, ALLOW_ANY_HOST=false).
# Comentários sempre em linha própria (comentário no fim da linha vira parte do valor).
DATABASE_URL=postgres://propostas:SENHA@localhost:5432/propostas
SECRET_KEY=gere-uma-chave-longa-e-aleatoria
# DEBUG=true: teste local. DEBUG=false: produção; ignora ALLOW_ANY_HOST/MODO_HTTP, esconde
# detalhes de erro, exige SECRET_KEY com 32+ caracteres e é o único modo aceito pelo servir.py.
DEBUG=true
# Desenvolvimento: aceita abrir propostas em qualquer host (localhost).
ALLOW_ANY_HOST=true
# Teste local sem HTTPS: desliga HSTS e cookie "secure". NUNCA em produção.
MODO_HTTP=true
# Produção: deixe PUBLIC_BASE_URL vazio (o link usa o domínio da empresa + PUBLIC_PROTOCOL).
PUBLIC_BASE_URL=http://localhost:8000
# PUBLIC_PROTOCOL=https
# Endereço do painel, usado nos links dos avisos.
ADMIN_BASE_URL=http://localhost:8000
SEED_ADMIN_EMAIL=admin@propostas.local
SEED_ADMIN_PASSWORD=trocar-esta-senha
UPLOAD_DIR=./uploads

# --- Atrás do Caddy (produção) ---
# Confia no X-Forwarded-Proto do proxy. Padrão: true quando MODO_HTTP=false.
# ATRAS_DE_PROXY=true
# Origens HTTPS aceitas nos formulários (separadas por vírgula).
# CSRF_TRUSTED_ORIGINS=https://painel.caddi.com.br,https://propostas.caddi.com.br,https://propostas.kolp.com.br,https://propostas.fasesistemas.com.br

# --- servir.py (waitress) ---
# HOST=127.0.0.1
# PORTA=8000
# THREADS=8

# --- Avisos por e-mail (sem SMTP_HOST, o aviso só vai para o log) ---
# SMTP_HOST=smtp.seudominio.com.br
# 587 = STARTTLS; para SSL direto use 465 e SMTP_SECURE=true
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=avisos@seudominio.com.br
# SMTP_PASS=
# SMTP_FROM=Propostas <avisos@seudominio.com.br>

# --- Avisos por WhatsApp: evolution, meta ou webhook (vazio = só log) ---
# WHATSAPP_PROVIDER=
# Evolution API
# EVOLUTION_URL=https://evolution.seudominio.com.br
# EVOLUTION_INSTANCE=
# EVOLUTION_APIKEY=
# WhatsApp Cloud API (Meta), com modelo de mensagem aprovado
# META_TOKEN=
# META_PHONE_ID=
# META_TEMPLATE=
# META_TEMPLATE_LANG=pt_BR
# Webhook genérico (n8n, Make, Zapier)
# WHATSAPP_WEBHOOK_URL=
# WHATSAPP_WEBHOOK_SECRET=

# --- D4Sign (contrato por assinatura eletrônica; ver deploy/D4SIGN.md) ---
# sandbox ou producao
# D4SIGN_AMBIENTE=sandbox
# D4SIGN_TOKEN_API=
# D4SIGN_CRYPT_KEY=
# Obrigatório em produção (DEBUG=false): sem ele o webhook responde 503.
# D4SIGN_WEBHOOK_TOKEN=
# Opcional: sobrescreve o endereço da API
# D4SIGN_BASE_URL=
