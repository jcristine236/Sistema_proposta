# Copie para web/.env e preencha.
DATABASE_URL=postgres://propostas:SENHA@localhost:5432/propostas
SECRET_KEY=gere-uma-chave-longa-e-aleatoria
DEBUG=true
# Desenvolvimento: aceita abrir propostas em qualquer host (localhost).
ALLOW_ANY_HOST=true
# Teste local sem HTTPS: desliga HSTS e cookie "secure". NUNCA em produção.
MODO_HTTP=true
PUBLIC_BASE_URL=http://localhost:8000
ADMIN_BASE_URL=http://localhost:8000
SEED_ADMIN_EMAIL=admin@propostas.local
SEED_ADMIN_PASSWORD=trocar-esta-senha
UPLOAD_DIR=./uploads
